generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id              Int             @id @default(autoincrement())
  name            String
  location        String?
  phone           String?
  latitude        Float?
  longitude       Float?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  admins          Admin[]
  chiqimlar       Chiqim[]
  kirimlar        Kirim[]
  usedTires       UsedTire[]
  users           User[]
  shopSettings    ShopSetting[]
  shopAdmins      ShopAdmin[]
  dollarHistories DollarHistory[]

  @@map("shops")
}

model Setting {
  id    Int     @id @default(autoincrement())
  key   String  @unique
  value String?

  @@map("settings")
}

model ShopSetting {
  shopId Int     @map("shop_id")
  key    String
  value  String?
  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, key])
  @@index([shopId])
  @@map("shop_settings")
}

model ShopAdmin {
  telegramId BigInt @map("telegram_id")
  shopId     Int    @map("shop_id")
  shop       Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([telegramId, shopId])
  @@index([shopId])
  @@index([telegramId])
  @@map("shop_admins")
}

model DollarHistory {
  id        Int      @id @default(autoincrement())
  kurs      Float
  shopId    Int      @map("shop_id")
  changedAt DateTime @default(now()) @map("changed_at")
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([shopId, changedAt(sort: Desc)])
  @@map("dollar_history")
}

model User {
  id           Int      @id @default(autoincrement())
  telegramId   BigInt?  @unique @map("telegram_id")
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  username     String?
  role         Role     @default(USER)
  shopId       Int?     @map("shop_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  passwordHash String?  @map("password_hash")
  phone        String?  @unique
  shop         Shop?    @relation(fields: [shopId], references: [id])

  @@index([telegramId])
  @@index([phone])
  @@map("users")
}

model Admin {
  id         Int      @id @default(autoincrement())
  telegramId BigInt   @unique @map("telegram_id")
  shopId     Int      @map("shop_id")
  createdAt  DateTime @default(now()) @map("created_at")
  shop       Shop     @relation(fields: [shopId], references: [id])
  chiqimlar  Chiqim[]

  @@index([telegramId])
  @@map("admins")
}

model Kirim {
  id            Int            @id @default(autoincrement())
  shopId        Int?           @map("shop_id")
  brand         String
  size          String
  priceBuy      Float          @map("price_buy")
  priceSell     Float          @map("price_sell")
  quantity      Int            @default(0)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  chiqimlar     Chiqim[]
  shop          Shop?          @relation(fields: [shopId], references: [id])
  warehouseLogs WarehouseLog[]

  @@unique([shopId, brand, size])
  @@index([shopId])
  @@index([brand])
  @@index([size])
  @@map("tires")
}

model UsedTire {
  id            Int            @id @default(autoincrement())
  shopId        Int?           @map("shop_id")
  size          String
  condition     TireCondition  @default(GOOD)
  priceBuy      Float          @map("price_buy")
  priceSell     Float?         @map("price_sell")
  quantity      Int            @default(0)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  chiqimlar     Chiqim[]
  shop          Shop?          @relation(fields: [shopId], references: [id])
  warehouseLogs WarehouseLog[]

  @@unique([shopId, size, condition])
  @@index([shopId])
  @@index([size])
  @@map("used_tires")
}

model Chiqim {
  id         Int       @id @default(autoincrement())
  itemType   ItemType  @map("item_type")
  tireId     Int?      @map("tire_id")
  usedTireId Int?      @map("used_tire_id")
  quantity   Int
  totalPrice Float     @map("total_price")
  adminId    Int       @map("admin_id")
  shopId     Int?      @map("shop_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  admin      Admin     @relation(fields: [adminId], references: [id])
  shop       Shop?     @relation(fields: [shopId], references: [id])
  kirim      Kirim?    @relation(fields: [tireId], references: [id])
  usedTire   UsedTire? @relation(fields: [usedTireId], references: [id])

  @@index([itemType])
  @@index([createdAt])
  @@index([shopId])
  @@map("sales")
}

model WarehouseLog {
  id         Int       @id @default(autoincrement())
  itemType   ItemType  @map("item_type")
  tireId     Int?      @map("tire_id")
  usedTireId Int?      @map("used_tire_id")
  logType    LogType   @map("log_type")
  quantity   Int
  price      Float
  createdAt  DateTime  @default(now()) @map("created_at")
  kirim      Kirim?    @relation(fields: [tireId], references: [id])
  usedTire   UsedTire? @relation(fields: [usedTireId], references: [id])

  @@index([itemType])
  @@index([logType])
  @@index([createdAt])
  @@map("warehouse_logs")
}

model RabochiyBalon {
  id        Int      @id @default(autoincrement())
  razmer    String
  balonTuri String   @map("balon_turi")
  soni      Int      @default(0)
  narx      Int      @default(0)
  holat     String?  @default("yaxshi")
  sana      DateTime @default(now())
  shopId    Int?     @map("shop_id")

  @@index([shopId])
  @@index([shopId], map: "idx_rabochiy_balon_shop")
  @@map("rabochiy_balon")
}

model Size {
  id   Int    @id @default(autoincrement())
  name String @unique

  @@map("sizes")
}

model Brand {
  id   Int    @id @default(autoincrement())
  name String @unique

  @@map("brands")
}

model OlinishKerak {
  id        Int    @id @default(autoincrement())
  razmer    String
  balonTuri String @map("balon_turi")
  soni      Int
  shopId    Int?   @map("shop_id")

  @@index([shopId])
  @@map("olinish_kerak")
}

model RabochiySotuv {
  id           Int      @id @default(autoincrement())
  razmer       String
  balonTuri    String   @map("balon_turi")
  olinganNarx  Int      @map("olingan_narx")
  sotilganNarx Int      @map("sotilgan_narx")
  sana         DateTime @default(now())
  shopId       Int?     @map("shop_id")

  @@index([shopId])
  @@map("rabochiy_sotuv")
}

enum Role {
  USER
  ADMIN
}

enum ItemType {
  NEW
  USED
}

enum LogType {
  IN
  OUT
}

enum TireCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
}
